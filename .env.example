# Optional BigQuery configuration. Never put credentials in this file.
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=global_weather_data
BIGQUERY_TABLE=current_weather_stats
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to your ignored key file:
# $env:GOOGLE_APPLICATION_CREDENTIALS="scripts/gcp-key.json"  (PowerShell)
# export GOOGLE_APPLICATION_CREDENTIALS="scripts/gcp-key.json"  (Linux/macOS)

